{
  "name": "vlab-editor",
  "version": "0.1.0",
  "description": "A composable React block editor built on ProseMirror, with Markdown and extensible toolbars.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./src/styles.css.d.ts",
      "default": "./src/styles.css"
    },
    "./highlight": {
      "types": "./dist/engine/highlight.d.ts",
      "import": "./dist/engine/highlight.js"
    }
  },
  "files": [
    "dist",
    "src/styles.css",
    "src/styles.css.d.ts",
    "src/react/*.css",
    "docs",
    "README.ko.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "dev": "pnpm build && pnpm --parallel --filter vlab-editor --filter @vlab-editor/playground dev:watch",
    "dev:watch": "tsc --watch",
    "build": "tsc",
    "build:playground": "pnpm build && pnpm --filter @vlab-editor/playground build",
    "preview": "pnpm --filter @vlab-editor/playground preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:playground",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "@testing-library/react": "16.3.3",
    "jsdom": "30.1.3",
    "vitest": "5.0.5",
    "@biomejs/biome": "2.6.2"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "markdown-it": "14.3.3",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.9",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.12.4",
    "prosemirror-view": "1.42.7",
    "tailwind-merge": "3.7.0",
    "@types/markdown-it": "14.2.0"
  },
  "license": "MIT",
  "author": "Victor-Choe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Victor-Choe/vlab-editor.git"
  },
  "homepage": "https://github.com/Victor-Choe/vlab-editor#readme",
  "bugs": {
    "url": "https://github.com/Victor-Choe/vlab-editor/issues"
  },
  "keywords": [
    "react",
    "prosemirror",
    "editor",
    "block-editor",
    "markdown",
    "rich-text",
    "typescript"
  ],
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
